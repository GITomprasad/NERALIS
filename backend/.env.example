# ==============================================================================
# NERALIS BACKEND ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Supabase PostgreSQL / SQLite Local)
# ------------------------------------------------------------------------------
# Default local SQLite:
DATABASE_URL=sqlite:///./neralis.db

# To connect to Supabase PostgreSQL:
# 1. Go to https://supabase.com -> Select your project -> Project Settings -> Database
# 2. Copy the URI under "Connection string" -> "URI" or "Connection Pooler" (Port 6543 / 5432)
# 3. Replace [YOUR-PASSWORD] with your database password:
#
# Examples:
# Direct Connection:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
#
# Connection Pooler (Recommended for serverless & cloud deployments):
# DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres

# ------------------------------------------------------------------------------
# 2. SUPABASE API & CLIENT KEYS (Optional - for Auth / Realtime / Storage)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 3. SECURITY & AUTHENTICATION
# ------------------------------------------------------------------------------
# Generate your own random values — never reuse the ones from this example
# file, and never commit real values here. e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`
SECRET_KEY=change-me-to-a-random-secret
NERALIS_API_KEY=change-me-to-a-random-api-key
GOOGLE_CLIENT_ID=

# ------------------------------------------------------------------------------
# 4. FAST INFERENCE AI ENGINE (Groq)
# ------------------------------------------------------------------------------
# Get a key at https://console.groq.com/keys — do not commit real keys.
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=openai/gpt-oss-120b

# ------------------------------------------------------------------------------
# 5. SIMULATION & TELEMETRY MODES
# ------------------------------------------------------------------------------
NERALIS_SIMULATION_MODE=true
