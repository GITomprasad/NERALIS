# ==============================================================================
# NERALIS FRONTEND ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================

# Backend FastAPI Server Base URL
VITE_API_BASE_URL=http://127.0.0.1:8000

# CARTO Basemaps API Key (Required for watermark-free CARTO Positron/Voyager raster tiles)
# Official Provider: https://carto.com/basemaps/apikey/
# In Render: Add as an Environment Variable in the frontend Static/Web service
VITE_CARTO_API_KEY=YOUR_CARTO_API_KEY

# Supabase Client Configuration (Optional - for direct frontend Supabase queries/auth)
VITE_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
